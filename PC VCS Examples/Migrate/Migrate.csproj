  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Prefer the .NET 4.0 targeting pack. Some legacy build machines have only
       CLR 4 installed; permit an explicit, visible fallback on those machines. -->
  <PropertyGroup Condition="'$(MigrateDisableRuntimeReferenceFallback)' != 'true' And '$(TargetFrameworkVersion)' == 'v4.0' And '$(TargetFrameworkRootPath)' == '' And '$(_TargetFrameworkDirectories)' == '' And '$(_FullFrameworkReferenceAssemblyPaths)' == '' And !Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.0\mscorlib.dll') And Exists('$(SystemRoot)\Microsoft.NET\Framework\v4.0.30319\mscorlib.dll')">
    <_MigrateUsingRuntimeReferences>true</_MigrateUsingRuntimeReferences>
    <_TargetFrameworkDirectories>$(SystemRoot)\Microsoft.NET\Framework\v4.0.30319\</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(_TargetFrameworkDirectories)</_FullFrameworkReferenceAssemblyPaths>
  </PropertyGroup>
  <Target Name="MigrateReportRuntimeReferences" BeforeTargets="PrepareForBuild" Condition="'$(_MigrateUsingRuntimeReferences)' == 'true'">
    <Warning Code="MIGRATE001" Text="The .NET Framework 4.0 targeting pack is missing. Migrate is compiling against installed CLR 4 assemblies in $(_TargetFrameworkDirectories). The application still targets .NET Framework 4.0; install its targeting pack for exact API targeting, or set MigrateDisableRuntimeReferenceFallback=true to require it." />
  </Target>
</Project>